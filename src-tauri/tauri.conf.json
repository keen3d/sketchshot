{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SketchShot",
  "version": "0.1.2",
  "identifier": "app.sketchshot.desktop",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SketchShot 스케치샷",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SketchShot",
    "shortDescription": "스케치·페인팅과 사진 리터칭·컨펌",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["sketchshot"],
        "name": "SketchShot.Document",
        "description": "SketchShot 작업 파일",
        "role": "Editor",
        "mimeType": "application/x-sketchshot"
      }
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean", "English"],
        "displayLanguageSelector": false
      }
    }
  }
}
